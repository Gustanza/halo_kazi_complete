    {
      "name": "00. Database Connection & System Health",
      "item": [
        {
          "name": "Check Oracle DB Connection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/db-test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "db-test"
              ]
            },
            "description": "Verifies live Oracle database connectivity by executing SELECT 1 FROM DUAL. Returns {\"status\":\"connected\"} on success."
          },
          "response": []
        },
        {
          "name": "Spring Boot Actuator Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Checks Spring Boot actuator health including readiness and liveness."
          },
          "response": []
        }
      ]
    },
